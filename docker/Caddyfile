{
	frankenphp
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	header {
		-Server
		-X-Powered-By
	}

	# Only index.php is executable; never serve dotfiles or source files.
	@hidden path /.* */.* *.php~ /composer.* /package.json
	respond @hidden 404

	php_server {
		index index.php
		file_server off
		try_files {path} index.php
	}
}
