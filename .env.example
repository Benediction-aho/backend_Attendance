# Assistance Ghana Attendance v2 – API. Placeholders only: never commit real secrets.
APP_NAME=Attendance
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# PWA origin (used in emails/links) and allowed CORS origins (comma-separated)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated proxy IPs/CIDRs, or * behind a trusted load balancer. Empty = trust none.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local PostgreSQL (docker-compose service "db"). Tests use database "attendance_test".
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=attendance
DB_USERNAME=attendance
DB_PASSWORD=change-me
DB_SSLMODE=prefer
# Optional runtime role (see docs/DEPLOYMENT.md): migrations grant it runtime privileges only.
DB_APP_ROLE=
# Owner role used only for migrations (defaults to DB_USERNAME).
DB_OWNER_USERNAME=
DB_OWNER_PASSWORD=
# Supabase (test environment), example:
# DB_HOST=db.ynspiijfjpumatmszmhx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=<set in the host secret store, never here>
# DB_SSLMODE=require

SESSION_DRIVER=array
SESSION_COOKIE=sid
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=att-cache-

# Mail: "log" locally; set MAIL_MAILER=resend and RESEND_API_KEY in test/production.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Private files (profile photos, reports): "local" in development/tests, "s3" (Supabase Storage, private bucket) online.
# Files are only reachable through short-lived URLs generated by the API.
PRIVATE_FILES_DISK=local
# S3-compatible storage (Supabase Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=https://ynspiijfjpumatmszmhx.storage.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# Error tracking
SENTRY_DSN=

# Web Push (VAPID) – phase 4. Generate a key pair; keep the private key secret.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
